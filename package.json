{
  "name": "markts_pou",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:app": "tsc && vite build",
    "build": "npm run build:app && electron-builder",
    "start": "electron .",
    "test": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test tests/world.test.mjs tests/world-store.test.mjs tests/workshop.test.mjs tests/survival.test.mjs tests/rival.test.mjs tests/frontier.test.mjs tests/equipment.test.mjs tests/loot.test.mjs",
    "test:ollama": "node --disable-warning=ExperimentalWarning --experimental-strip-types tests/ollama-smoke.mjs",
    "test:electron": "node tests/electron-smoke.mjs",
    "test:workshop": "node tests/electron-smoke.mjs --oficina",
    "test:recipes": "node --disable-warning=ExperimentalWarning --experimental-strip-types tests/recipes-ollama.mjs",
    "test:renovate": "node --disable-warning=ExperimentalWarning --experimental-strip-types tests/renovate-ollama.mjs",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "main": "dist-electron/main.js"
}
